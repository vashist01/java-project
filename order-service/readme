global:
  scrape_interval: 5s #promethuses will collect metrix every 5 second from the all target
  e.g 10:00:00 → scrape metrics
      10:00:05 → scrape again
      10:00:10 → scrape again wh important
      1 smaller interval = more real time monitering
      2 larger interval - less load

scrape_configs: # this section tell promethuse what on moniter

  - job_name: 'prometheus' # moniter service
    static_configs:
      - targets: ['localhost:9090'] # where metrix are avaiable
      // exposing metrix own at http://localhost:9090/metrics prometheus_tsdb_head_series
           prometheus_engine_query_duration_seconds
           So this job monitors Prometheus health itself.

  - job_name: 'node'
    static_configs:
      - targets: ['localhost:9100']

  - job_name: 'spring-app'
    metrics_path: '/actuator/prometheus'
    static_configs:
      - targets: ['localhost:8080']